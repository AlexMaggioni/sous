#!/usr/bin/env node
// A fake Claude Code CLI, as the Claude Agent SDK drives it: stream-json in and out, the
// control protocol, --resume, a result with structured_output when --json-schema is given,
// usage numbers, and the usage-limit messages. It answers as lib.mjs decides and logs each
// user turn to FAKE_LOG. `claude --version` prints a version like the real one, or FAKE_VERSION.
// MCP servers come from the settings in CLAUDE_CONFIG_DIR, then --mcp-config, then the
// initialize request. A later one replaces a server of the same name whole.
// Steering works as in Claude Code 2.1.331: a user message with priority next that comes during a
// turn is queued, and the turn reads it after its current tool call. Each message with a uuid
// gets command_lifecycle frames (queued, started, completed), and the result lists the uuids the
// turn read in user_message_uuids. A message the turn never read starts a turn of its own after
// the result. A message with priority now or later stops the fake with an error, since sous never
// sends one. Each session keeps the user messages it read in claude-sessions/<id>, one per line.
// --fork-session copies the parent's messages to the new session first. `claude --resume <id>`
// with no stream is a person at a terminal: it adds FAKE_PERSON's line and exits. A goal rule
// plays several model turns, and an ask rule sends a can_use_tool request. lib.mjs says more.
// Cost: each result costs COST. A result's total_cost_usd is the session's whole cost so far, as
// Claude Code restores a session's total on a resume. The totals live in claude-costs/<id>.

import { randomUUID } from "node:crypto";
import { appendFileSync, copyFileSync, existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { appendLog, debug, decide, loginPresent, mcpSummary, readJsonLines, sessionMessages, statusObject, valueWith, waitFor, writeFiles } from "./lib.mjs";

const VERSION = process.env.FAKE_VERSION ?? "2.1.330";
const argv = process.argv.slice(2);

if (argv.includes("--version") || argv.includes("-v")) {
  process.stdout.write(`${VERSION} (Claude Code)\n`);
  process.exit(0);
}

/** Flags as the SDK writes them: --name value, --name=value, or --name alone. */
function parseFlags(args) {
  const flags = {};
  for (let i = 0; i < args.length; i++) {
    const arg = args[i];
    if (!arg.startsWith("--")) continue;
    let name = arg.slice(2);
    let value = true;
    const eq = name.indexOf("=");
    if (eq >= 0) {
      value = name.slice(eq + 1);
      name = name.slice(0, eq);
    } else if (i + 1 < args.length && !args[i + 1].startsWith("--")) {
      value = args[++i];
    }
    if (name in flags) flags[name] = [].concat(flags[name], value);
    else flags[name] = value;
  }
  return flags;
}

const flags = parseFlags(argv);
const list = (value) => (typeof value === "string" && value !== "" ? value.split(",") : value === "" ? [] : undefined);
const parseJson = (value) => {
  try {
    return typeof value === "string" ? JSON.parse(value) : undefined;
  } catch {
    return undefined;
  }
};

const resumeId = typeof flags.resume === "string" ? flags.resume : undefined;
const forking = Boolean(resumeId && flags["fork-session"]);
// A fork gets a session of its own: the one --session-id names, or a new one.
const sessionId = typeof flags["session-id"] === "string" ? flags["session-id"] : forking ? randomUUID() : (resumeId ?? randomUUID());
const schema = parseJson(flags["json-schema"]);
const mcpConfig = parseJson(flags["mcp-config"]);

/** The user's own MCP servers, from .claude.json in CLAUDE_CONFIG_DIR. */
function configuredServers() {
  const dir = process.env.CLAUDE_CONFIG_DIR;
  if (!dir || !existsSync(join(dir, ".claude.json"))) return {};
  return parseJson(readFileSync(join(dir, ".claude.json"), "utf8"))?.mcpServers ?? {};
}
const mcpServers = () => ({ ...configuredServers(), ...mcpConfig?.mcpServers, ...state.init.mcpServers });

const BUILT_IN = ["Bash", "Edit", "Glob", "Grep", "Read", "Write"];
/** The built-in tools the session has: --tools limits them, --disallowedTools removes them. */
function sessionTools() {
  const only = list(flags.tools);
  const denied = new Set((list(flags.disallowedTools) ?? []).map((entry) => entry.replace(/\(.*\)$/, "")));
  return BUILT_IN.filter((tool) => (!only || only.includes(tool)) && !denied.has(tool));
}
const sessionsDir = join(dirname(process.env.FAKE_LOG ?? join(process.cwd(), "fake.log")), "claude-sessions");

// The real CLI fails a resume of a session it never saved.
if (resumeId && !existsSync(join(sessionsDir, resumeId))) {
  process.stderr.write(`No conversation found with session ID: ${resumeId}\n`);
  process.exit(1);
}

// A person at a terminal: no stream to read. The fake types FAKE_PERSON's line and leaves.
if (resumeId && flags["input-format"] === undefined && flags.print === undefined && !argv.includes("-p")) {
  const line = process.env.FAKE_PERSON ?? "";
  if (line !== "") {
    appendFileSync(join(sessionsDir, resumeId), `${JSON.stringify({ role: "user", text: line })}\n`);
    appendLog({ program: "claude", sessionId: resumeId, byHand: line });
  }
  process.exit(0);
}

// The fork starts with the parent's messages. The parent's file stays as it was.
if (forking && resumeId !== sessionId) copyFileSync(join(sessionsDir, resumeId), join(sessionsDir, sessionId));

const MODELS = [
  { value: "default", displayName: "Default (recommended)", description: "Fake default model", supportsAutoMode: true, supportsEffort: true, supportedEffortLevels: ["low", "medium", "high"] },
  { value: "sonnet", displayName: "Sonnet", description: "Fake Sonnet", supportsAutoMode: true, supportsEffort: true, supportedEffortLevels: ["low", "medium", "high"] },
  { value: "opus", displayName: "Opus", description: "Fake Opus", supportsAutoMode: true, supportsEffort: true, supportedEffortLevels: ["low", "medium", "high"] },
  { value: "haiku", displayName: "Haiku", description: "Fake Haiku" },
];
const modelName = (alias) => (!alias || alias === "default" ? "claude-sonnet-fake" : alias.startsWith("claude-") ? alias : `claude-${alias}-fake`);

const state = {
  model: typeof flags.model === "string" ? flags.model : undefined,
  effort: typeof flags.effort === "string" ? flags.effort : undefined,
  /** The mode a set_permission_mode request gave. The flag stays in argv. */
  permissionMode: undefined,
  init: {},
  turn: undefined,
  queue: [],
};

const write = (message) => {
  debug("claude", "out", message);
  process.stdout.write(`${JSON.stringify(message)}\n`);
};

const USAGE = { input_tokens: 120, cache_creation_input_tokens: 0, cache_read_input_tokens: 0, output_tokens: 30 };
/** A rule's usage in the API's field names. */
const apiUsage = (spent) => ({ input_tokens: spent.input ?? 0, cache_creation_input_tokens: spent.cacheWrite ?? 0, cache_read_input_tokens: spent.cacheRead ?? 0, output_tokens: spent.output ?? 0 });
const COST = 0.0012;
const costsDir = join(dirname(process.env.FAKE_LOG ?? join(process.cwd(), "fake.log")), "claude-costs");
/** The session's cost so far: what its earlier processes reported last, then each result of this one. */
let costSoFar = resumeId && !forking && existsSync(join(costsDir, resumeId)) ? Number(readFileSync(join(costsDir, resumeId), "utf8")) || 0 : 0;
/** The session's total that a result reports, and keeps for the next resume. A result that sets its own total keeps none. */
function sessionCost(fields) {
  if (typeof fields.total_cost_usd === "number") return fields.total_cost_usd;
  costSoFar += COST;
  mkdirSync(costsDir, { recursive: true });
  writeFileSync(join(costsDir, sessionId), String(costSoFar));
  return costSoFar;
}

/** Control requests the fake sent and waits on, by request id. */
const pending = new Map();
/** Sends a control request to the SDK. Resolves with its response: { subtype, response, error }. */
function ask(request) {
  const id = `fake_req_${randomUUID().slice(0, 8)}`;
  return new Promise((resolve) => {
    pending.set(id, resolve);
    write({ type: "control_request", request_id: id, request });
  });
}

function respond(requestId, response = {}) {
  write({ type: "control_response", response: { subtype: "success", request_id: requestId, response } });
}

function onControl(message) {
  const request = message.request ?? {};
  switch (request.subtype) {
    case "initialize":
      state.init = request;
      respond(message.request_id, {
        ...(request.mcpServers !== undefined ? { mcp_servers_applied: true } : {}),
        commands: [],
        agents: [],
        output_style: "default",
        available_output_styles: ["default"],
        models: MODELS,
        account: { email: "fake@example.invalid", subscriptionType: "max", tokenSource: "claude.ai" },
        pid: 0,
      });
      return;
    case "set_model":
      state.model = request.model ?? undefined;
      respond(message.request_id);
      return;
    case "apply_flag_settings":
      if (request.settings && "effortLevel" in request.settings) state.effort = request.settings.effortLevel ?? undefined;
      if (request.settings && "model" in request.settings) state.model = request.settings.model ?? undefined;
      respond(message.request_id);
      return;
    case "set_permission_mode":
      state.permissionMode = request.mode ?? undefined;
      respond(message.request_id);
      return;
    case "interrupt":
      if (state.turn) state.turn.interrupted = true;
      respond(message.request_id);
      return;
    case "mcp_status":
      respond(message.request_id, { mcpServers: mcpSummary(mcpServers()).map((server) => ({ name: server.name, status: "connected" })) });
      return;
    default:
      respond(message.request_id);
  }
}

/** The text blocks of a user message, in order. */
function promptTexts(message) {
  const content = message.message?.content;
  if (typeof content === "string") return [content];
  if (!Array.isArray(content)) return [];
  return content.filter((block) => block?.type === "text").map((block) => block.text);
}

/** A user message's text: its text blocks, joined with a newline, so a rule sees each one. */
const promptText = (message) => promptTexts(message).join("\n");

/** The images a user message carries, as { mimeType, data }. */
function promptImages(message) {
  const content = message.message?.content;
  if (!Array.isArray(content)) return [];
  return content.filter((block) => block?.type === "image").map((block) => ({ mimeType: block.source?.media_type ?? null, data: block.source?.data ?? null }));
}

const base = () => ({ session_id: sessionId, uuid: randomUUID() });
const sessionState = (value) => write({ type: "system", subtype: "session_state_changed", state: value, ...base() });
/** A frame on the way of a user message that carries a uuid: queued, started, completed or cancelled. */
const lifecycle = (commandUuid, value) => write({ type: "command_lifecycle", command_uuid: commandUuid, state: value, ...base() });
/** Adds a user message the session read to its transcript. */
function transcript(text) {
  mkdirSync(sessionsDir, { recursive: true });
  appendFileSync(join(sessionsDir, sessionId), `${JSON.stringify({ role: "user", text })}\n`);
}
const steerLine = (message, value) => appendLog({ program: "claude", sessionId, steer: { id: message.uuid ?? null, text: promptText(message), priority: message.priority ?? null }, state: value });

/** The turn reads its queued messages, as Claude Code does after a tool call. */
function readQueued(turn) {
  for (const queued of turn.queue.splice(0)) {
    if (queued.uuid) {
      lifecycle(queued.uuid, "started");
      turn.read.push(queued.uuid);
    }
    transcript(promptText(queued));
    steerLine(queued, "read");
  }
}

function toolUse(model, id, command) {
  const message = assistant(model, "", {});
  message.message.content = [{ type: "tool_use", id, name: "Bash", input: { command } }];
  message.message.stop_reason = "tool_use";
  return message;
}

function assistant(model, text, extra = {}, usage = USAGE) {
  return {
    type: "assistant",
    message: {
      id: `msg_fake_${randomUUID().slice(0, 8)}`,
      type: "message",
      role: "assistant",
      model,
      content: [{ type: "text", text }],
      stop_reason: "end_turn",
      stop_sequence: null,
      usage: model === "<synthetic>" ? { input_tokens: 0, output_tokens: 0, cache_creation_input_tokens: 0, cache_read_input_tokens: 0 } : usage,
    },
    parent_tool_use_id: null,
    ...extra,
    ...base(),
  };
}

function streamText(model, text) {
  const event = (body) => write({ type: "stream_event", event: body, parent_tool_use_id: null, ...base() });
  event({ type: "message_start", message: { id: `msg_fake_${randomUUID().slice(0, 8)}`, type: "message", role: "assistant", model, content: [], stop_reason: null, usage: { ...USAGE, output_tokens: 1 } } });
  event({ type: "content_block_start", index: 0, content_block: { type: "text", text: "" } });
  event({ type: "content_block_delta", index: 0, delta: { type: "text_delta", text } });
  event({ type: "content_block_stop", index: 0 });
}

function result(fields) {
  const turn = state.turn;
  for (const uuid of turn?.read ?? []) lifecycle(uuid, "completed");
  const cost = sessionCost(fields);
  write({
    type: "result",
    duration_ms: 1000,
    duration_api_ms: 900,
    num_turns: 1,
    stop_reason: "end_turn",
    total_cost_usd: cost,
    usage: { ...USAGE, server_tool_use: { web_search_requests: 0, web_fetch_requests: 0 }, service_tier: "standard" },
    modelUsage: {
      [modelName(state.model)]: { inputTokens: 120, outputTokens: 30, cacheReadInputTokens: 0, cacheCreationInputTokens: 0, webSearchRequests: 0, costUSD: cost, contextWindow: 200000, maxOutputTokens: 64000 },
    },
    permission_denials: [],
    user_message_uuids: [...(turn?.uuid ? [turn.uuid] : []), ...(turn?.read ?? [])],
    ...fields,
    ...base(),
  });
  if (turn?.uuid) lifecycle(turn.uuid, "completed");
}

let initSent = false;

async function runTurn(message, fromTell = false) {
  const prompt = promptText(message);
  const texts = promptTexts(message);
  const images = promptImages(message);
  const system = state.init.appendSystemPrompt ?? flags["append-system-prompt"];
  const decision = decide("claude", prompt, schema, { session: sessionId, system: typeof system === "string" ? system : "", earlier: sessionMessages(join(sessionsDir, sessionId)), last: texts.at(-1) ?? "" });
  // queue holds the messages sent into the turn, read the uuids of those it has read.
  const turn = { interrupted: false, uuid: message.uuid, queue: [], read: [], fromTell };
  state.turn = turn;
  if (message.uuid) lifecycle(message.uuid, "started");
  appendLog({
    program: "claude",
    argv,
    cwd: process.cwd(),
    model: state.model ?? null,
    effort: state.effort ?? null,
    // Only when set, so the baseline's golden lines stay as they were.
    ...(state.permissionMode ? { permissionMode: state.permissionMode } : {}),
    sessionId,
    resume: Boolean(resumeId),
    ...(forking ? { fork: true } : {}),
    schema: schema ?? null,
    mcpServers: mcpSummary(mcpServers()),
    allowedTools: list(flags.allowedTools) ?? [],
    disallowedTools: list(flags.disallowedTools) ?? [],
    tools: list(flags.tools) ?? null,
    systemPrompt: state.init.systemPrompt ?? flags["system-prompt"] ?? null,
    appendSystemPrompt: state.init.appendSystemPrompt ?? flags["append-system-prompt"] ?? null,
    skills: state.init.skills ?? null,
    login: loginPresent(),
    prompt,
    // Only with more than one, so the baseline's golden lines stay as they were.
    ...(texts.length > 1 ? { texts } : {}),
    ...(images.length ? { images } : {}),
    rule: decision.rule,
    outcome: decision.kind,
  });
  transcript(prompt);

  // The replay of the user message tells the SDK client which turn is now running.
  write({ ...message, session_id: sessionId, isReplay: true });
  sessionState("running");
  if (!initSent) {
    initSent = true;
    write({
      type: "system",
      subtype: "init",
      cwd: process.cwd(),
      tools: sessionTools(),
      mcp_servers: mcpSummary(mcpServers()).map((server) => ({ name: server.name, status: "connected" })),
      model: modelName(state.model),
      permissionMode: typeof flags["permission-mode"] === "string" ? flags["permission-mode"] : "default",
      slash_commands: [],
      apiKeySource: "none",
      claude_code_version: VERSION,
      output_style: "default",
      agents: [],
      skills: [],
      plugins: [],
      ...base(),
    });
  }

  const model = modelName(state.model);
  const toolId = `toolu_fake_${randomUUID().slice(0, 8)}`;
  if (decision.tool) write(toolUse(model, toolId, decision.tool));
  await waitFor(decision, () => turn.interrupted);
  if (decision.kind === "exit") {
    process.stderr.write("fake crash\n");
    process.exit(decision.code);
  }
  if (decision.tool && !turn.interrupted) {
    write({ type: "user", message: { role: "user", content: [{ type: "tool_result", tool_use_id: toolId, content: "ok", is_error: false }] }, parent_tool_use_id: null, ...base() });
    readQueued(turn);
  }
  const asked = decision.ask && decision.kind === "answer" && !turn.interrupted ? await askQuestion(model, decision.ask) : undefined;
  // A rule's usage is what the turn spent before it failed or stopped, in one model message.
  const spent = decision.usage ? { usage: { ...apiUsage(decision.usage), server_tool_use: { web_search_requests: 0, web_fetch_requests: 0 }, service_tier: "standard" } } : {};
  if (decision.usage && decision.kind !== "answer") write(assistant(model, "Working on it.", {}, apiUsage(decision.usage)));

  if (turn.interrupted) {
    write({ type: "user", message: { role: "user", content: [{ type: "text", text: "[Request interrupted by user]" }] }, parent_tool_use_id: null, ...base() });
    result({ subtype: "error_during_execution", is_error: true, errors: ["Request interrupted by user"], stop_reason: null, ...spent });
  } else if (decision.kind === "limit") {
    // By default the limit hits on the turn's second request: one real answer, then the rejection.
    if (!decision.first) {
      streamText(model, "Working on it.");
      write(assistant(model, "Working on it."));
    }
    write({ type: "rate_limit_event", rate_limit_info: { status: "rejected", resetsAt: decision.resetsAt, rateLimitType: "five_hour", overageStatus: "rejected" }, ...base() });
    const text = "You've hit your limit · resets soon";
    write(assistant("<synthetic>", text, { error: "rate_limit" }));
    result({ subtype: "success", is_error: true, result: text, ...(decision.first ? { usage: { ...apiUsage({}), server_tool_use: { web_search_requests: 0, web_fetch_requests: 0 }, service_tier: "standard" }, total_cost_usd: 0 } : {}) });
  } else if (decision.kind === "auth") {
    const text = "Invalid API key · Please run /login";
    write(assistant("<synthetic>", text, { error: "authentication_failed" }));
    result({ subtype: "success", is_error: true, result: text, api_error_status: 401, usage: { ...apiUsage({}), server_tool_use: { web_search_requests: 0, web_fetch_requests: 0 }, service_tier: "standard" }, total_cost_usd: 0 });
  } else if (decision.kind === "fail") {
    const text = `API Error: 500 ${decision.message}`;
    write(assistant("<synthetic>", text, { error: "server_error" }));
    result({ subtype: "success", is_error: true, result: text, ...spent });
  } else if (asked === "interrupted") {
    result({ subtype: "error_during_execution", is_error: true, errors: ["Request interrupted by user for tool use"], stop_reason: null });
  } else if (decision.goal !== undefined) {
    await playGoal(model, decision, turn);
  } else if (decision.listTools) {
    const text = sessionTools().join(",");
    streamText(model, text);
    write(assistant(model, text));
    result({ subtype: "success", is_error: false, result: text });
  } else {
    writeFiles(decision.files, process.cwd());
    streamText(model, decision.text);
    write(assistant(model, decision.text));
    result({ subtype: "success", is_error: false, result: decision.text, ...(decision.stop ? { stop_reason: decision.stop } : {}), ...(schema ? { structured_output: decision.value } : {}) });
  }
  sessionState("idle");
  if (decision.mark) writeFileSync(join(dirname(process.env.FAKE_LOG ?? "."), decision.mark), "");
  state.turn = undefined;
  // A message the turn never read runs as a turn of its own.
  const unread = turn.queue.splice(0);
  for (const queued of unread) chain = chain.then(() => runTurn(queued, true));
  if (inputEnded && !unread.length) process.exit(0);
}

/**
 * The model calls AskUserQuestion, as a turn of an ask rule does. Returns "interrupted" when the
 * client denies it with interrupt, so the turn ends there.
 */
async function askQuestion(model, wanted) {
  if ((list(flags.disallowedTools) ?? []).some((entry) => entry.replace(/\(.*\)$/, "") === "AskUserQuestion")) {
    appendLog({ program: "claude", sessionId, ask: { skipped: "disallowed" } });
    return undefined;
  }
  const question = typeof wanted === "string" ? wanted : "Which way should I go?";
  const input = { questions: [{ question, header: "Choice", options: [{ label: "Left", description: "Go left." }, { label: "Right", description: "Go right." }], multiSelect: false }] };
  const toolId = `toolu_fake_${randomUUID().slice(0, 8)}`;
  const call = assistant(model, "", {});
  call.message.content = [{ type: "tool_use", id: toolId, name: "AskUserQuestion", input }];
  call.message.stop_reason = "tool_use";
  write(call);
  const reply = await ask({ subtype: "can_use_tool", tool_name: "AskUserQuestion", input, tool_use_id: toolId });
  const answer = reply?.response ?? {};
  if (reply?.subtype !== "success") appendLog({ program: "claude", sessionId, ask: { error: reply?.error ?? "no reply" } });
  else appendLog({ program: "claude", sessionId, ask: { behavior: answer.behavior ?? null, message: answer.message ?? null, interrupt: answer.interrupt === true } });
  const allowed = reply?.subtype === "success" && answer.behavior === "allow";
  const said = allowed ? "The person picked Left." : (answer.message ?? reply?.error ?? "The tool was refused.");
  write({ type: "user", message: { role: "user", content: [{ type: "tool_result", tool_use_id: toolId, content: said, is_error: !allowed }] }, parent_tool_use_id: null, ...base() });
  if (reply?.subtype === "success" && answer.behavior === "deny" && answer.interrupt === true) {
    write({ type: "user", message: { role: "user", content: [{ type: "text", text: "[Request interrupted by user for tool use]" }] }, parent_tool_use_id: null, ...base() });
    return "interrupted";
  }
  return undefined;
}

/**
 * A /goal turn: N model turns, with the Stop hook's feedback between them, then one result. With
 * a schema the structured output rule ends it after the first model turn, as working.
 */
async function playGoal(model, decision, turn) {
  const turns = schema ? 1 : Math.max(1, Number(decision.goal) || 1);
  for (let at = 1; at <= turns; at++) {
    if (at > 1) {
      const feedback = `Stop hook feedback: The goal is not met yet. Model turn ${at} of ${decision.goal} goes on.`;
      transcript(feedback);
      write({ type: "user", message: { role: "user", content: [{ type: "text", text: feedback }] }, parent_tool_use_id: null, ...base() });
    }
    appendLog({ program: "claude", sessionId, goal: { turn: at, of: decision.goal } });
    const met = at === turns && !schema;
    if (met) writeFiles(decision.files, process.cwd());
    const said = met ? decision.text : `Working on the goal, model turn ${at}.`;
    streamText(model, said);
    write(assistant(model, said));
    if (turn.interrupted) break;
  }
  if (turn.interrupted) {
    result({ subtype: "error_during_execution", is_error: true, errors: ["Request interrupted by user"], stop_reason: null });
  } else if (schema) {
    const value = valueWith(schema, statusObject("working"));
    result({ subtype: "success", is_error: false, result: JSON.stringify(value), num_turns: turns, structured_output: value });
  } else {
    result({ subtype: "success", is_error: false, result: decision.text, num_turns: turns });
  }
}

function onUser(message) {
  if (message.priority === "now" || message.priority === "later") {
    process.stderr.write(`fake claude: a user message came with priority ${message.priority}. "now" aborts the turn and "later" starts a second one, so sous must send "next".\n`);
    process.exit(70);
  }
  if (message.uuid) lifecycle(message.uuid, "queued");
  if (state.turn && message.priority === "next") {
    steerLine(message, "queued");
    state.turn.queue.push(message);
    return;
  }
  chain = chain.then(() => runTurn(message));
}

let chain = Promise.resolve();
readJsonLines(process.stdin, (message) => {
  debug("claude", "in", message);
  if (message.type === "control_request") onControl(message);
