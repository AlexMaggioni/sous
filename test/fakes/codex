#!/usr/bin/env node
// A fake Codex CLI. `codex app-server` speaks JSON-RPC over stdio as the Codex adapter drives it.
// It has initialize, thread start and resume, model list, a turn with an output schema, token usage,
// interrupt, requests to the client (approvals and questions), and MCP servers from
// $CODEX_HOME/config.toml, `-c` and the thread config. A thread's servers deep-merge into
// configured ones of the same name, as the real 0.169.0 does. It answers as lib.mjs decides and
// logs each turn to FAKE_LOG.
// turn/steer works as in 0.169.0: during a turn it answers with the turn id and adds a userMessage
// item to the turn. After the turn it fails with -32600 "no active turn to steer". A rule's
// notSteerable makes it fail with activeTurnNotSteerable instead, as a compact turn does. Each
// thread keeps the user messages it read in codex-threads/<id>, one per line.
// `codex --version` prints a version like the real one, or FAKE_VERSION.

import { randomUUID } from "node:crypto";
import { appendFileSync, existsSync, mkdirSync, readFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { appendLog, debug, decide, limitRule, loginPresent, mcpSummary, readJsonLines, waitFor } from "./lib.mjs";

const VERSION = process.env.FAKE_VERSION ?? "0.169.0";
const argv = process.argv.slice(2);

if (argv.includes("--version") || argv.includes("-V")) {
  process.stdout.write(`codex-cli ${VERSION}\n`);
  process.exit(0);
}
if (!argv.includes("app-server")) {
  process.stderr.write("This fake codex only runs `codex app-server` and `codex --version`.\n");
  process.exit(2);
}

/** `-c key=value` overrides, with the value read as JSON when it parses. */
function overrides(args) {
  const out = {};
  for (let i = 0; i < args.length; i++) {
    if (args[i] !== "-c" && args[i] !== "--config") continue;
    const pair = args[++i] ?? "";
    const eq = pair.indexOf("=");
    if (eq < 0) continue;
    const raw = pair.slice(eq + 1);
    let value = raw;
    try {
      value = JSON.parse(raw);
    } catch {
      value = raw;
    }
    out[pair.slice(0, eq)] = value;
  }
  return out;
}

/** MCP servers from `-c mcp_servers.<name>.<key>=...` overrides. */
function mcpFromOverrides(given) {
  const servers = {};
  for (const [key, value] of Object.entries(given)) {
    const match = /^mcp_servers\.([^.]+)(?:\.(.+))?$/.exec(key);
    if (!match) continue;
    const server = (servers[match[1]] ??= {});
    if (match[2]) server[match[2]] = value;
    else Object.assign(server, value);
  }
  return servers;
}

/** The TOML the tests write: [dotted.headers], and key = string, number, boolean or array. */
function parseToml(text) {
  const root = {};
  let table = root;
  for (const raw of text.split("\n")) {
    const line = raw.trim();
    if (!line || line.startsWith("#")) continue;
    const header = /^\[([^\]]+)\]$/.exec(line);
    if (header) {
      table = root;
      for (const key of header[1].split(".").map((part) => part.trim().replace(/^"|"$/g, ""))) table = table[key] ??= {};
      continue;
    }
    const eq = line.indexOf("=");
    if (eq < 0) continue;
    const key = line.slice(0, eq).trim().replace(/^"|"$/g, "");
    table[key] = JSON.parse(line.slice(eq + 1).trim().replace(/'([^']*)'/g, '"$1"'));
  }
  return root;
}

const configFile = process.env.CODEX_HOME ? join(process.env.CODEX_HOME, "config.toml") : undefined;
const userConfig = configFile && existsSync(configFile) ? parseToml(readFileSync(configFile, "utf8")) : {};

/** Codex's merge of config layers: tables merge key by key, other values replace. */
function deepMerge(base, over) {
  if (!over || typeof over !== "object" || Array.isArray(over)) return over;
  const out = { ...(base && typeof base === "object" && !Array.isArray(base) ? base : {}) };
  for (const [key, value] of Object.entries(over)) out[key] = deepMerge(out[key], value);
  return out;
}

const cliOverrides = overrides(argv);
const threadsDir = join(dirname(process.env.FAKE_LOG ?? join(process.cwd(), "fake.log")), "codex-threads");
const threads = new Map();

const MODEL = {
  id: "gpt-fake",
  model: "gpt-fake",
  upgrade: null,
  upgradeInfo: null,
  availabilityNux: null,
  displayName: "GPT Fake",
  description: "Fake Codex model",
  modelSpecialty: null,
  hidden: false,
  supportedReasoningEfforts: ["low", "medium", "high"].map((reasoningEffort) => ({ reasoningEffort, description: reasoningEffort })),
  defaultReasoningEffort: "medium",
  inputModalities: ["text"],
  supportsPersonality: false,
  multiAgentVersion: null,
  additionalSpeedTiers: [],
  serviceTiers: [],
  defaultServiceTier: null,
  availableAccessPrograms: null,
  isDefault: true,
};

const USAGE = { totalTokens: 150, inputTokens: 120, cachedInputTokens: 0, cacheWriteInputTokens: 0, outputTokens: 30, reasoningOutputTokens: 0 };
/** A rule's usage as Codex counts it, with cached tokens inside inputTokens. */
function codexUsage(spent) {
  if (!spent) return USAGE;
  const inputTokens = (spent.input ?? 0) + (spent.cacheRead ?? 0) + (spent.cacheWrite ?? 0);
  const outputTokens = spent.output ?? 0;
  return { totalTokens: inputTokens + outputTokens, inputTokens, cachedInputTokens: spent.cacheRead ?? 0, cacheWriteInputTokens: spent.cacheWrite ?? 0, outputTokens, reasoningOutputTokens: 0 };
}

/** The rate limits account/rateLimits/read reports: the codex limit rule's window, else a fresh one. */
function rateLimits() {
  const limit = limitRule("codex");
  const primary = limit ? { usedPercent: 100, windowDurationMins: 300, resetsAt: limit.resetsAt ?? null } : { usedPercent: 0, windowDurationMins: 300, resetsAt: null };
  return { limitId: "codex", limitName: null, normalModelSlug: null, primary, secondary: null, credits: null, individualLimit: null, spendControlReached: null, planType: "plus", rateLimitReachedType: limit ? "rate_limit_reached" : null };
}

const send = (message) => {
  debug("codex", "out", message);
  process.stdout.write(`${JSON.stringify(message)}\n`);
};
const notify = (method, params) => send({ method, params });

// Requests the fake sends to the client, waiting on their answers.
const asked = new Map();
let askedId = 0;
function ask(method, params) {
  const id = `fake-${++askedId}`;
  return new Promise((resolve) => {
    asked.set(id, resolve);
    send({ id, method, params });
  });
}

function threadView(thread) {
  return {
    id: thread.id,
    sessionId: thread.id,
    forkedFromId: null,
    parentThreadId: null,
    preview: thread.preview ?? "",
    ephemeral: false,
    section: null,
    sectionEnteredAt: null,
    projectId: null,
    historyMode: "full",
    modelProvider: "openai",
    model: thread.model,
    reasoningEffort: thread.effort,
    createdAt: 1700000000,
    updatedAt: 1700000000,
    status: { type: "idle" },
    path: null,
    cwd: thread.cwd,
    cliVersion: VERSION,
    source: "appServer",
    gitInfo: null,
    name: null,
    turns: [],
  };
}

function threadResponse(thread) {
  return {
    thread: threadView(thread),
    model: thread.model,
    modelProvider: "openai",
    serviceTier: null,
    reasoningEffort: thread.effort,
    disabledPluginIds: [],
    cwd: thread.cwd,
    instructionSources: [],
    approvalPolicy: "never",
    approvalsReviewer: "user",
    sandbox: { type: "workspaceWrite", writableRoots: [], networkAccess: false, excludeTmpdirEnvVar: false, excludeSlashTmp: false },
    turnsBackwardsCursor: null,
  };
}

/** The thread's MCP servers, or the error the real config loader gives on a transport clash. */
function threadServers(config) {
  const merged = deepMerge(deepMerge(userConfig.mcp_servers ?? {}, mcpFromOverrides(cliOverrides)), config.mcp_servers ?? {});
  for (const [name, server] of Object.entries(merged)) {
    if (server?.url !== undefined && server?.command !== undefined) {
      const base = userConfig.mcp_servers?.[name];
      const clash = base?.url !== undefined ? "command is not supported for streamable_http" : "url is not supported for stdio";
      return { error: `failed to load configuration: ${clash}\nin \`mcp_servers.${name}\`\n` };
    }
  }
  return { servers: Object.fromEntries(Object.entries(merged).filter(([, server]) => server?.enabled !== false)) };
}

function openThread(params, resumed) {
  const config = params.config ?? {};
  const id = resumed ? params.threadId : randomUUID();
  const thread = {
    id,
    resumed,
    cwd: params.cwd ?? process.cwd(),
    config,
    model: params.model ?? config.model ?? cliOverrides.model ?? MODEL.id,
    effort: config.model_reasoning_effort ?? cliOverrides.model_reasoning_effort ?? null,
    baseInstructions: params.baseInstructions ?? null,
    developerInstructions: params.developerInstructions ?? null,
    mcpServers: threadServers(config).servers,
    turn: undefined,
  };
  threads.set(id, thread);
  return thread;
}

/** Adds a user message the thread read to its transcript. */
function transcript(thread, text) {
  mkdirSync(threadsDir, { recursive: true });
  appendFileSync(join(threadsDir, thread.id), `${JSON.stringify({ role: "user", text })}\n`);
}

/** turn/steer: the error it fails with. Without one, it answers and adds the message to the turn. */
function steer(params, reply) {
  const thread = threads.get(params.threadId);
  const turn = thread?.turn;
  const text = promptText(params.input);
  const log = (state) => appendLog({ program: "codex", sessionId: params.threadId ?? null, steer: { id: params.clientUserMessageId ?? null, text, expectedTurnId: params.expectedTurnId ?? null }, state });
  if (!thread) return { code: -32600, message: `thread not found: ${params.threadId}` };
  if (!turn) {
    log("no_active_turn");
    return { code: -32600, message: "no active turn to steer" };
  }
  if (params.expectedTurnId !== turn.id) {
    log("wrong_turn");
    return { code: -32600, message: `expected active turn id \`${params.expectedTurnId}\` but found \`${turn.id}\`` };
  }
  if (turn.noSteer) {
    log("unknown_method");
    return { code: -32600, message: "Invalid request: unknown variant `turn/steer`, expected one of `initialize`, `thread/start`, `turn/start`, `turn/interrupt`" };
  }
  if (turn.notSteerable) {
    log("not_steerable");
    const message = `cannot steer a ${turn.notSteerable} turn`;
    return { code: -32600, message, data: { message, codexErrorInfo: { activeTurnNotSteerable: { turnKind: turn.notSteerable } }, additionalDetails: null, misalignment: null } };
  }
  log("read");
  transcript(thread, text);
  const base = { threadId: thread.id, turnId: turn.id };
  const item = { type: "userMessage", id: `user_${randomUUID().slice(0, 8)}`, clientId: params.clientUserMessageId ?? null, content: params.input ?? [] };
  // The answer goes first, then the item, as the real one sends them.
  reply({ turnId: turn.id });
  notify("item/started", { ...base, item, startedAtMs: 1700000000000 });
  notify("item/completed", { ...base, item, completedAtMs: 1700000000000 });
  return undefined;
}

function promptText(input) {
  return (input ?? [])
    .filter((item) => item?.type === "text")
    .map((item) => item.text)
    .join("\n");
}

/** The images a turn's input carries, as { mimeType, data }, from their data URLs. */
function promptImages(input) {
  return (input ?? [])
    .filter((item) => item?.type === "image")
    .map((item) => {
      const parts = /^data:([^;]+);base64,(.*)$/.exec(item.url ?? "");
      return parts ? { mimeType: parts[1], data: parts[2] } : { mimeType: null, data: null, url: item.url ?? null };
    });
}

/**
 * What a rule's `approval` makes the fake ask the client. A string is a command to run. An
 * object has a `kind`, as lib.mjs lists them. When the request belongs to a thread item, `item`
 * builds it: `ran` is undefined while it waits, then whether the client let it run.
 */
function approvalRequest(approval, thread, base) {
  const spec = typeof approval === "string" ? { kind: "command", command: approval } : approval;
  const at = { ...base, itemId: "call_fake", startedAtMs: 1700000000000 };
  const status = (ran, done, refused) => (ran === undefined ? "inProgress" : ran ? done : refused);
  switch (spec.kind) {
    case "command": {
      const command = { type: "commandExecution", id: "call_fake", pluginId: null, scriptPath: null, command: spec.command, cwd: thread.cwd, processId: null, source: "agent", commandActions: [], durationMs: null };
      return {
        method: "item/commandExecution/requestApproval",
        params: { kind: "command", ...at, environmentId: null, reason: null, command: spec.command, cwd: thread.cwd },
        accepts: (result) => result.decision === "accept" || result.decision === "acceptForSession",
        item: (ran) => ({ ...command, status: status(ran, "completed", "declined"), aggregatedOutput: ran ? "" : null, exitCode: ran ? 0 : null }),
      };
    }
    case "fileChange": {
      const file = { type: "fileChange", id: "call_fake", changes: [{ path: spec.path ?? "src/fake.txt", kind: { type: "update", move_path: null }, diff: "" }] };
      return {
        method: "item/fileChange/requestApproval",
        params: { ...at, reason: null, grantRoot: null },
        accepts: (result) => result.decision === "accept" || result.decision === "acceptForSession",
        item: (ran) => ({ ...file, status: status(ran, "completed", "declined") }),
      };
    }
    case "permissions":
      return { method: "item/permissions/requestApproval", params: { ...at, environmentId: null, cwd: thread.cwd, reason: null, permissions: { network: spec.network ?? null, fileSystem: spec.fileSystem ?? null } } };
    case "mcp": {
      // Codex tells the client which tool runs in an item, then asks about it as a form.
      const call = { type: "mcpToolCall", id: "call_fake", server: spec.server ?? "demo", tool: spec.tool ?? "lookup", arguments: {}, appContext: null, mcpAppUi: null, pluginId: null, readOnlyHint: null, durationMs: null };
      return {
        method: "mcpServer/elicitation/request",
        params: { threadId: base.threadId, turnId: base.turnId, serverName: call.server, mode: "form", _meta: { codex_approval_kind: "mcp_tool_call" }, message: `Allow the ${call.server} server to run ${call.tool}?`, requestedSchema: { type: "object", properties: {} } },
        accepts: (result) => result.action === "accept",
        item: (ran) => ({ ...call, status: status(ran, "completed", "failed"), result: ran ? { content: [], structuredContent: null, _meta: null } : null, error: ran === false ? { message: "user cancelled MCP tool call" } : null }),
      };
    }
    case "form":
      return { method: "mcpServer/elicitation/request", params: { threadId: base.threadId, turnId: base.turnId, serverName: spec.server ?? "demo", mode: "form", _meta: null, message: spec.message ?? "Which region should it use?", requestedSchema: { type: "object", properties: { region: { type: "string" } } } } };
    case "question":
      return { method: "item/tool/requestUserInput", params: { ...base, itemId: "call_fake", questions: [{ id: "region", header: "Region", question: spec.message ?? "Which region should it use?", isOther: false, isSecret: false, options: null }] } };
    default:
      throw new Error(`The fake codex has no approval kind ${spec.kind}.`);
  }
}

async function runTurn(thread, turnId, params) {
  const prompt = promptText(params.input);
  const images = promptImages(params.input);
  const schema = params.outputSchema ?? null;
  const decision = decide("codex", prompt, schema);
  const turn = { id: turnId, interrupted: false, notSteerable: decision.notSteerable, noSteer: decision.noSteer };
  thread.turn = turn;
  const model = params.model ?? thread.model;
  const base = { threadId: thread.id, turnId };
  const disabledTools = Object.fromEntries(
    Object.entries(thread.mcpServers)
      .filter(([, server]) => server.disabled_tools?.length)
      .map(([name, server]) => [name, server.disabled_tools]),
  );
  // The request comes before the log line, so the line can hold the client's answer.
  let request;
  let answer;
  if (decision.approval) {
    request = approvalRequest(decision.approval, thread, base);
    if (request.item) notify("item/started", { ...base, item: request.item(undefined), startedAtMs: 1700000000000 });
    answer = await ask(request.method, request.params);
  }
  appendLog({
    program: "codex",
    argv,
    cwd: params.cwd ?? thread.cwd,
    model,
    effort: params.effort ?? thread.effort ?? null,
    sessionId: thread.id,
    resume: thread.resumed,
    schema,
    mcpServers: mcpSummary(thread.mcpServers),
    approvalPolicy: params.approvalPolicy ?? null,
    ...(Object.keys(disabledTools).length ? { disabledTools } : {}),
    sandboxPolicy: params.sandboxPolicy?.type ?? null,
    baseInstructions: thread.baseInstructions,
    developerInstructions: thread.developerInstructions,
    login: loginPresent(),
    prompt,
    ...(images.length ? { images } : {}),
    rule: decision.rule,
    outcome: decision.kind,
    ...(answer ? { approval: answer.error ? { error: answer.error } : answer.result } : {}),
  });
  transcript(thread, prompt);
  thread.preview ||= prompt.slice(0, 80);

  const turnView = (status, items = [], error = null) => ({ id: turnId, items, itemsView: "full", status, error, startedAt: 1700000000, completedAt: status === "inProgress" ? null : 1700000001, durationMs: status === "inProgress" ? null : 1000 });
  notify("turn/started", { threadId: thread.id, turn: turnView("inProgress") });

  const tool = decision.tool && { type: "commandExecution", id: `call_${randomUUID().slice(0, 8)}`, pluginId: null, scriptPath: null, command: decision.tool, cwd: thread.cwd, processId: null, source: "agent", commandActions: [], durationMs: null };
  if (tool) notify("item/started", { ...base, item: { ...tool, status: "inProgress", aggregatedOutput: null, exitCode: null }, startedAtMs: 1700000000000 });
  await waitFor(decision, () => turn.interrupted);
  if (decision.kind === "exit") {
    process.stderr.write("fake crash\n");
    process.exit(decision.code);
  }
  if (tool && !turn.interrupted) notify("item/completed", { ...base, item: { ...tool, status: "completed", aggregatedOutput: "ok", exitCode: 0 }, completedAtMs: 1700000000500 });
  thread.turn = undefined;

  if (request?.item) notify("item/completed", { ...base, item: request.item(request.accepts(answer.result ?? {})), completedAtMs: 1700000000500 });
  // A failed or stopped turn still reports what it spent, as the real one does.
  const spent = () => notify("thread/tokenUsage/updated", { ...base, tokenUsage: { total: codexUsage(decision.usage), last: codexUsage(decision.usage), modelContextWindow: 272000 } });
  if (turn.interrupted) {
    spent();
    notify("turn/completed", { threadId: thread.id, turn: turnView("interrupted") });
    return;
  }
  if (decision.kind === "limit" && !decision.silent) {
    // The real app-server reports the spent window, with its reset time, before the error.
    const window = { usedPercent: 100, windowDurationMins: 300, resetsAt: decision.resetsAt ?? null };
    const rateLimits = { limitId: "codex", limitName: null, normalModelSlug: null, primary: window, secondary: null, credits: null, individualLimit: null, spendControlReached: null, planType: "plus", rateLimitReachedType: "rate_limit_reached" };
    notify("account/rateLimits/updated", { rateLimits });
  }
  if (decision.kind !== "answer") {
    const errors = {
      limit: { message: "You've hit your usage limit. Upgrade to Pro or try again later.", codexErrorInfo: "usageLimitExceeded", additionalDetails: null, misalignment: null },
      auth: { message: "unexpected status 401 Unauthorized: Missing bearer or basic authentication in header", codexErrorInfo: "unauthorized", additionalDetails: null, misalignment: null },
      fail: { message: decision.message, codexErrorInfo: decision.errorInfo ?? "internalServerError", additionalDetails: null, misalignment: null },
    };
    const error = errors[decision.kind];
    if (decision.kind === "fail") spent();
    notify("error", { ...base, error, willRetry: false });
    notify("turn/completed", { threadId: thread.id, turn: turnView("failed", [], error) });
    return;
  }
  const itemId = `msg_${randomUUID().slice(0, 8)}`;
  const item = { type: "agentMessage", id: itemId, text: "", phase: null, memoryCitation: null, delivery: null, questions: null };
  notify("item/started", { ...base, item, startedAtMs: 1700000000000 });
  notify("item/agentMessage/delta", { ...base, itemId, delta: decision.text });
  const done = { ...item, text: decision.text };
  notify("item/completed", { ...base, item: done, completedAtMs: 1700000001000 });
  notify("thread/tokenUsage/updated", { ...base, tokenUsage: { total: USAGE, last: USAGE, modelContextWindow: 272000 } });
  notify("turn/completed", { threadId: thread.id, turn: turnView("completed", [done]) });
}

function onRequest(message) {
  const { id, method } = message;
  const params = message.params ?? {};
  const reply = (result) => send({ id, result });
  const fail = (code, text, data) => send({ id, error: { code, message: text, ...(data ? { data } : {}) } });
  switch (method) {
    case "initialize":
      return reply({ userAgent: `codex_cli_rs/${VERSION} (fake)`, codexHome: join(dirname(threadsDir), "codex-home"), platformFamily: "unix", platformOs: "macos" });
    case "account/read":
      return reply({ account: { type: "chatgpt", email: null, planType: "plus" }, requiresOpenaiAuth: true });
    case "account/rateLimits/read": {
      const snapshot = rateLimits();
      return reply({ ordinaryUsageAllowed: true, rateLimits: snapshot, rateLimitsByLimitId: { codex: snapshot }, rateLimitResetCredits: null, accountId: null, rateLimitUpsell: null });
    }
    case "skills/list":
      return reply({ data: [] });
    case "model/list":
      return reply({ data: [MODEL], nextCursor: null });
    case "config/read": {
      const layers = configFile && existsSync(configFile) ? [{ name: { type: "user", file: configFile, profile: null }, version: "fake", config: userConfig, disabledReason: null }] : [];
      return reply({ config: { ...userConfig, ...cliOverrides }, origins: {}, layers: params.includeLayers ? layers : null });
    }
    case "thread/start":
    case "thread/resume": {
      const resumed = method === "thread/resume";
      if (resumed && !existsSync(join(threadsDir, params.threadId ?? ""))) return fail(-32600, `no rollout found for thread id ${params.threadId}`);
      const { error } = threadServers(params.config ?? {});
      if (error) return fail(-32603, error);
      return reply(threadResponse(openThread(params, resumed)));
    }
    case "thread/read": {
      const thread = threads.get(params.threadId);
      if (!thread) return fail(-32600, `thread not found: ${params.threadId}`);
      return reply({ thread: threadView(thread) });
    }
    case "turn/start": {
      const thread = threads.get(params.threadId);
      if (!thread) return fail(-32600, `thread not found: ${params.threadId}`);
      const turnId = randomUUID();
      reply({ turn: { id: turnId, items: [], itemsView: "full", status: "inProgress", error: null, startedAt: 1700000000, completedAt: null, durationMs: null } });
      thread.chain = (thread.chain ?? Promise.resolve()).then(() => runTurn(thread, turnId, params));
      return;
    }
    case "turn/steer": {
      const error = steer(params, reply);
      if (error) fail(error.code, error.message, error.data);
      return;
    }
    case "turn/interrupt": {
      const thread = threads.get(params.threadId);
      if (thread?.turn) thread.turn.interrupted = true;
      return reply({});
    }
    case "thread/unsubscribe":
      threads.delete(params.threadId);
      return reply({ status: "unsubscribed" });
    default:
      return reply({});
  }
}

readJsonLines(process.stdin, (message) => {
  debug("codex", "in", message);
  if (message.method && message.id !== undefined) onRequest(message);
  else if (!message.method && asked.has(message.id)) {
    asked.get(message.id)(message);
    asked.delete(message.id);
  }
});
process.stdin.on("end", () => process.exit(0));
process.on("SIGTERM", () => process.exit(143));
debug("codex", "argv", argv);
