{
  "name": "@orchestrator/orc",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "bin": {
    "orc": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "HOME=\"$(mktemp -d)\" tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@orchestrator/acp-agents": "workspace:*",
    "@orchestrator/shared-types": "workspace:*",
    "@orchestrator/engine": "workspace:*",
    "smol-toml": "1.9.1",
    "yaml": "2.9.0"
  }
}
