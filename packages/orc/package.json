{
  "name": "@orchestrator/orc",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "bin": {
    "orc": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@automatalabs/acp-agents": "workspace:*",
    "@automatalabs/shared-types": "workspace:*",
    "@automatalabs/workflow-engine": "workspace:*",
    "@automatalabs/workflows": "workspace:*"
  }
}
